# Edda local development env contract.
# Copy to `.env`, adjust values, and run the app.

# Database
EDDA_DB_URL=postgres://edda:edda@localhost:5432/edda?sslmode=disable

# LLM provider: ollama, claude, or openrouter
EDDA_LLM_PROVIDER=ollama

# Ollama-compatible inference, used when EDDA_LLM_PROVIDER=ollama.
EDDA_LLM_OLLAMA_ENDPOINT=http://10.0.0.50:11434
EDDA_LLM_OLLAMA_MODEL=ollama/qwen3:14b
EDDA_LLM_OLLAMA_CONTEXTTOKENBUDGET=8000
EDDA_LLM_OLLAMA_TIMEOUTSECONDS=600
EDDA_LLM_OLLAMA_APIKEY=

# Ollama-compatible embeddings. Leave empty to reuse EDDA_LLM_OLLAMA_ENDPOINT.
EDDA_LLM_OLLAMA_EMBEDDINGENDPOINT=http://10.0.0.50:11434
EDDA_LLM_OLLAMA_EMBEDDINGMODEL=nomic-embed-text
EDDA_LLM_OLLAMA_EMBEDDINGDIMENSION=768

# Independent semantic memory for any GM provider (Ollama-compatible /api/embed).
# Leave ALL of these unset to retain legacy Ollama settings above. Explicit
# ENABLED=false disables semantic memory even when the GM provider is Ollama.
# Enabled memory requires its own base endpoint, model and positive dimension.
# EDDA_LLM_MEMORYEMBEDDING_ENABLED=true
# EDDA_LLM_MEMORYEMBEDDING_PROVIDER=ollama
# EDDA_LLM_MEMORYEMBEDDING_ENDPOINT=http://localhost:11434
# EDDA_LLM_MEMORYEMBEDDING_MODEL=nomic-embed-text
# EDDA_LLM_MEMORYEMBEDDING_DIMENSION=768
# Optional Bearer token for this embedding endpoint; never inherits the GM key.
# EDDA_LLM_MEMORYEMBEDDING_APIKEY=

# Claude, required only when EDDA_LLM_PROVIDER=claude. REASONINGEFFORT sets
# output_config.effort (low, medium, high, xhigh or max).
# API key precedence: EDDA_LLM_CLAUDE_APIKEY > ANTHROPIC_API_KEY
# EDDA_LLM_CLAUDE_APIKEY=sk-ant-...
EDDA_LLM_CLAUDE_MODEL=claude-sonnet-5-5
EDDA_LLM_CLAUDE_REASONINGEFFORT=high
EDDA_LLM_CLAUDE_CONTEXTTOKENBUDGET=8000

# OpenRouter, required only when EDDA_LLM_PROVIDER=openrouter.
# API key precedence: EDDA_LLM_OPENROUTER_APIKEY > OPENROUTER_API_KEY
# EDDA_LLM_OPENROUTER_APIKEY=sk-or-v1-...
# Sonnet 5.5 at high effort; OpenRouter retries on GPT-6.1 Terra when it fails.
# FALLBACKMODELS is a comma-separated list, tried in order.
EDDA_LLM_OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
EDDA_LLM_OPENROUTER_FALLBACKMODELS=openai/gpt-6.1-terra
EDDA_LLM_OPENROUTER_REASONINGEFFORT=high
EDDA_LLM_OPENROUTER_CONTEXTTOKENBUDGET=8000

# ChatGPT plan, used when EDDA_LLM_PROVIDER or EDDA_LLM_FALLBACKPROVIDER is
# chatgpt. Requests run on the signed-in person's ChatGPT plan; create the file
# with `go run ./cmd/chatgpt-login`.
# EDDA_LLM_FALLBACKPROVIDER=chatgpt
# EDDA_LLM_CHATGPT_CREDENTIALSFILE=/home/you/.config/edda/chatgpt-auth.json
# EDDA_LLM_CHATGPT_MODEL=gpt-6.1-terra
# EDDA_LLM_CHATGPT_REASONINGEFFORT=high

# Claude on your own Claude subscription through cmd/claude-bridge (see README).
# EDDA_LLM_CLAUDECODE_ENDPOINT=http://10.0.0.50:18095
# EDDA_LLM_CLAUDECODE_TOKEN=

# Optional model routing profiles. Prefer YAML config for many profiles; env
# vars are useful for quick local overrides. Routes fall back to EDDA_LLM_PROVIDER.
# EDDA_LLM_PROFILES_FAST_PROVIDER=openrouter
# EDDA_LLM_PROFILES_FAST_MODEL=mistralai/mistral-small-3.2-24b-instruct
# EDDA_LLM_PROFILES_FAST_CONTEXTTOKENBUDGET=8000
# EDDA_LLM_PROFILES_FAST_TOOLSUPPORT=true
# EDDA_LLM_ROUTES_CHOICEFALLBACK=fast
# EDDA_LLM_ROUTES_POSTTURNSTATE=fast
# EDDA_LLM_ROUTES_GMTURN=fast

# Server
EDDA_SERVER_PORT=8080
# Required for JWT-signed sessions. Generate with: openssl rand -hex 32
EDDA_SERVER_JWTSECRET=
# Set to false to stop new accounts being created.
# EDDA_SERVER_ALLOWREGISTRATION=true
